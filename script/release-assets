#!/bin/bash
# Build what a release is made from, at the versions Gemfile.lock pins:
#
#   dist/*.gem      the ovlens gem and the dependency gems a stock Ruby still
#                   needs, for the harpworks gem index (miharp/packages)
#   build/stage/    the same gems installed as a tree, for the rpm and deb
#                   (script/package)
#
# Run it with the oldest Ruby ovlens supports.
#
# How the set is chosen: every locked runtime gem goes into a throwaway index,
# and ovlens is installed from that index alone into an empty GEM_HOME, with
# Ruby's own default and bundled gems (irb, bigdecimal and the like) visible
# through GEM_PATH. RubyGems then takes from the index only what a stock Ruby
# cannot already satisfy, at the locked version. Those stock gems are in the
# OpenVox agent's Ruby too, so nothing shipped needs a compiler.
set -euo pipefail

dist="${DIST_DIR:-dist}"
build="${BUILD_DIR:-build}"
version=$(ruby -Ilib -rovlens/version -e 'print Ovlens::VERSION')
work=$(mktemp -d)
mkdir -p "$work/index/gems" "$dist" "$build/stage/opt/ovlens/gems"

script/locked-runtime-gems | while read -r name locked; do
  ( cd "$work/index/gems" && gem fetch "$name" --version "$locked" --platform ruby > /dev/null )
done
gem build ovlens.gemspec --output "$work/index/gems/ovlens-$version.gem" > /dev/null
# `gem generate_index` left RubyGems for a gem of its own.
gem help generate_index > /dev/null 2>&1 || gem install --no-document rubygems-generate_index > /dev/null
gem generate_index --directory "$work/index" > /dev/null

GEM_HOME="$work/tree" GEM_PATH="$work/tree:$(ruby -e 'print Gem.default_dir')" \
  gem install --no-document --clear-sources --source "file://$work/index" ovlens --version "$version" > /dev/null

# One package has to serve every agent Ruby, so a compiled extension cannot ship.
if [ -n "$(find "$work/tree/extensions" -type f 2> /dev/null)" ]; then
  echo "a runtime gem has a native extension; it cannot go into a noarch package" >&2
  exit 1
fi

cp "$work"/tree/cache/*.gem "$dist/"
cp -R "$work/tree/gems" "$work/tree/specifications" "$build/stage/opt/ovlens/gems/"
echo "gems: $(cd "$dist" && ls -- *.gem | tr '\n' ' ')"
